{
  "name": "doodle-stories",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "stripe": "^22.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "node node_modules/react-scripts/bin/react-scripts.js build",
    "start:clear": "npm --prefix expo run start:clear",
    "expo:start": "npm --prefix expo run start",
    "expo:start:clear": "npm --prefix expo run start:clear",
    "expo:start:tunnel": "npm --prefix expo run start:tunnel",
    "eas:build": "npm --prefix expo exec -- eas build",
    "eas:build:android": "npm --prefix expo exec -- eas build --platform android --profile preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
